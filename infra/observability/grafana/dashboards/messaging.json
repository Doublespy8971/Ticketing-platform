        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (reason) (rate(notification_claim_release_total[5m]))",
          "legendFormat": "Claim Release: {{reason}}",
          "refId": "B"
        }
      ],
      "title": "Notification Claim Wait and Release Counters",
      "type": "timeseries"
    }
