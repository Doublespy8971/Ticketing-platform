POSTGRES_USER=ticketing
POSTGRES_PASSWORD=ticketing_secret
POSTGRES_INVENTORY_PORT=5433
POSTGRES_ORDER_PORT=5434
POSTGRES_PAYMENT_PORT=5435
REDIS_PORT=6379
