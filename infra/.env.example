# Development-only JWT secret key (must be at least 32 bytes / 256 bits for HS256). NEVER use in production!
JWT_SECRET=dev-only-hs256-secret-key-minimum-32-bytes-long!

# Development-only Grafana admin credentials. NEVER use in production!
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

