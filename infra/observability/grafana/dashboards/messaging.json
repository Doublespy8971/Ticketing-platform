  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Consumer group lag near zero across all topics indicates consumers are keeping up with Kafka event streams.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (consumergroup, topic) (clamp_min(kafka_consumergroup_lag, 0))",
          "legendFormat": "{{consumergroup}} -> {{topic}}",
          "refId": "A"
        }
      ],
      "title": "Consumer Group Lag per Group and Topic",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Dead-letter topic (-dlt) offsets should remain flat at zero; retry topic offsets should only increase during transient errors.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (kafka_topic_partition_current_offset{topic=~\".*-(retry-[01]|dlt)\"})",
          "legendFormat": "Offset: {{topic}}",
          "refId": "A"
        }
      ],
      "title": "Retry and Dead-Letter Topic End Offsets",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Zero increase over 1 hour on dead-letter topics indicates zero poison messages routed to DLT.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (topic) (increase(kafka_topic_partition_current_offset{topic=~\".*-(retry-[01]|dlt)\"}[1h]))",
          "legendFormat": "1h Increase: {{topic}}",
          "refId": "A"
        }
      ],
      "title": "Dead-Letter and Retry Topic 1h Increase",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Outbox unpublished queue depth below 50 records confirms outbox pollers are draining committed events within 200ms.",
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "id": 4,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "ticketing_outbox_unpublished_records{service=~\"$service\"}",
          "legendFormat": "Unpublished: {{service}}",
          "refId": "A"
        }
      ],
      "title": "Outbox Unpublished Rows per Service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Oldest unpublished outbox row age below 1 second indicates real-time event publishing without pipeline stalls.",
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 0,
        "y": 16
      },
      "id": 5,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "outbox_oldest_pending_age_seconds{service=~\"$service\"}",
          "legendFormat": "Oldest Age: {{service}}",
          "refId": "A"
        }
      ],
      "title": "Outbox Oldest Pending Age per Service",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Duplicate delivery rate should remain low and retried events should remain near zero during steady-state processing.",
      "fieldConfig": {
        "defaults": {
          "unit": "events/s"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 8,
        "x": 8,
        "y": 16
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, consumer_group) (rate(consumer_events_duplicate_total{service=~\"$service\"}[5m]))",
          "legendFormat": "Duplicate: {{service}} ({{consumer_group}})",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (service, consumer_group) (rate(consumer_events_retried_total{service=~\"$service\"}[5m]))",
          "legendFormat": "Retried: {{service}} ({{consumer_group}})",
          "refId": "B"
        }
      ],
      "title": "Consumer Duplicate and Retried Counters",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Zero claim releases and minimal claim waits indicate healthy Redis deduplication lock handoffs between notification workers.",
